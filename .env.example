# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token for localhost only. Register it in the Firebase console.
# Put the real value in .env.local, never here.
VITE_APPCHECK_DEBUG_TOKEN=
