# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token for localhost only. Register it in the Firebase console.
# Put the real value in .env.local, never here.
VITE_APPCHECK_DEBUG_TOKEN=

# The extension's App Check bridge: the hosted appcheck.html page, such as
# https://<project>.web.app/appcheck.html. When set, the extension gets real
# reCAPTCHA Enterprise tokens through it and carries no debug token.
VITE_APPCHECK_BRIDGE_URL=

# Gmail alert sync in the extension: the "Web application" OAuth client whose
# redirect URI is https://<extension id>.chromiumapp.org/
VITE_GMAIL_WEB_CLIENT_ID=
