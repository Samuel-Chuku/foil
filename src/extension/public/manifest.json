{
  "manifest_version": 3,
  "name": "Vendor payment desk (dev)",
  "version": "0.0.1",
  "description": "Verify bank-transfer payments and capture orders on WhatsApp Web, on your own device.",
  "minimum_chrome_version": "139",
  "action": {
    "default_title": "Open payment desk"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/extension/sidepanel.html"
  },
  "permissions": ["sidePanel", "identity"],
  "key": "",
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsappMain.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "run_at": "document_idle"
    }
  ]
}
