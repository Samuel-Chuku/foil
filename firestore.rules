rules_version = '2';

// The books hold amounts, states and times for a signed-in vendor, and only
// that vendor can read or write them. Each field list is closed, so a client
// that tried to add a name, phone, address or account number would be
// refused here too.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vendors/{uid}/books/{orderId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isBookEntry(request.resource.data, orderId);
    }

    // What became of money that paid no order: refunded, owed back or kept.
    match /vendors/{uid}/money/{moneyId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isMoneyEntry(request.resource.data);
    }

    function isBookEntry(d, orderId) {
      return d.keys().hasOnly(['orderId', 'mode', 'amountKobo', 'dueKobo',
          'paidKobo', 'payment', 'decidedBy', 'delivery', 'createdAt',
          'updatedAt', 'paidAt'])
        && d.orderId == orderId
        && d.mode in ['everyday', 'drop']
        && (d.amountKobo == null || d.amountKobo is int)
        && (d.dueKobo == null || d.dueKobo is int)
        && d.paidKobo is int && d.paidKobo >= 0
        && d.payment in ['awaiting', 'matched', 'not yet credited',
          'mismatch', 'check']
        && (d.decidedBy == null || d.decidedBy in ['rules', 'vendor'])
        && d.delivery in ['pending', 'out', 'delivered', 'collected']
        && d.createdAt is int
        && d.updatedAt is int
        && (d.paidAt == null || d.paidAt is int);
    }

    function isMoneyEntry(d) {
      return d.keys().hasOnly(['id', 'amountKobo', 'state', 'arrivedAt',
          'updatedAt'])
        && d.id is string && d.id.size() <= 200
        && d.amountKobo is int && d.amountKobo > 0
        && d.state in ['refund owed', 'refunded', 'kept']
        && (d.arrivedAt == null || d.arrivedAt is int)
        && d.updatedAt is int;
    }
  }
}
